# Copy to .env (or load however you manage secrets) and fill in real values.

# Empirical Security API (OAuth2 client credentials)
EMPIRICAL_CLIENT_ID=your-empirical-client-id
EMPIRICAL_CLIENT_SECRET=your-empirical-client-secret

# Qualys VM/FO APIs — KnowledgeBase + Host Detection (HTTP Basic auth)
QUALYS_USERNAME=your-qualys-username
QUALYS_PASSWORD=your-qualys-password
# API Server URL for your Qualys account (Help > About in the Qualys UI)
QUALYS_API_URL=https://qualysapi.qg2.apps.qualys.com

# --- simple-qid-posture-export: validation + optional email alerts ---
# A run with fewer than MIN_ROWS output rows is flagged: logged as an error, the
# process exits non-zero, and (if configured below) an email alert is sent.
# Default 500; set 0 to disable the check. Override per-run with --min-rows.
MIN_ROWS=500

# Email alerts are OFF unless ALERT_EMAIL_TO is set. Delivery uses the host's
# `mailx`, so the host must have mailx installed and a working mail setup
# (local MTA / relay). Comma-separate multiple recipients.
ALERT_EMAIL_TO=
# Optional sender passed to `mailx -r`; leave blank to use the host default.
ALERT_EMAIL_FROM=
# Optional subject override; leave blank for a sensible default.
ALERT_EMAIL_SUBJECT=
