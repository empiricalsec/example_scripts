# Copy to .env (or load however you manage secrets) and fill in real values.

# Empirical Security API (OAuth2 client credentials)
EMPIRICAL_CLIENT_ID=your-empirical-client-id
EMPIRICAL_CLIENT_SECRET=your-empirical-client-secret

# Qualys KnowledgeBase API (HTTP Basic auth)
QUALYS_USERNAME=your-qualys-username
QUALYS_PASSWORD=your-qualys-password
# API Server URL for your Qualys account (Help > About in the Qualys UI)
QUALYS_API_URL=https://qualysapi.qg2.apps.qualys.com
